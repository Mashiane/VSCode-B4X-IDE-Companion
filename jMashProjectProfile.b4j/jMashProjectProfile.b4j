'This subroutine takes the file either opened or saved and writes it to
'the recent items file. I add the file path and name to a Map to make sure
'I don't have duplicates without specifically testing each one. I use a pipe
'delimeter as that's what I'm used to. I want the flexibility of changing how
'I express the file name as well. Either that, or I could also extract the
'filepath and filename, I did what I was comfortable with for now, to get it working.
Sub SaveRecentItems(strPath As String, strFile As String)
    Dim recentItemsMap As Map
    recentItemsMap.Initialize
    recentItemsMap.Put(strPath & "|" & strFile, "1")
    If File.IsDirectory(File.dirapp, "recentitems.lib") = False Then
        If File.Exists(File.dirapp, "recentitems.lib") = True Then
            Dim recentItemsList As List
            recentItemsList.Initialize
            recentItemsList = ReadRecentItemsList
            If recentItemsList.Size > 0 Or recentItemsList.Get(0) <> "" Then
                For i = 0 To recentItemsList.Size - 1
                    recentItemsMap.Put(recentItemsList.Get(i), "1")
                Next
               
            End If
        End If
    End If
    Dim listWrite As List
    listWrite.Initialize
    For Each mapkey As String In recentItemsMap.Keys
        listWrite.Add(mapkey)
    Next
    File.WriteList(File.DirApp, "recentitems.lib", listWrite)
End Sub

'Just retrieves the list as I do that in a couple of places. Inherent laziness.
Sub ReadRecentItemsList() As List
    Dim recentList As List
    recentList.Initialize
    If File.IsDirectory(File.DirApp, "recentitems.lib") = False Then
        If File.Exists(File.DirApp, "recentitems.lib") = True Then
            recentList = File.ReadList(File.DirApp, "recentitems.lib")
        End If
    End If
    Return recentList
End Sub

'When the app loads, I clean up the list by removing anyting the user has deleted. I'll be adding a "Delete Profile" later today.
Sub cleanupRecentItems
    Dim listWrite As List
    listWrite.Initialize
    listWrite.Clear
    Dim recentFilesList As List
    recentFilesList.Initialize
    recentFilesList = ReadRecentItemsList
    Dim strLine As String
    Dim strLinePath As String
    Dim strLineName As String
    For i = 0 To recentFilesList.Size - 1
       If recentFilesList.Get(i) <> "" Then
            strLine = recentFilesList.Get(i)
            If strLine.IndexOf("|") > 0 Then
                strLinePath = strLine.SubString2(0, strLine.IndexOf("|"))
                strLineName = strLine.SubString(strLine.IndexOf("|") + 1)
                If strLinePath <> "" And strLineName <> "" Then
                    If File.Exists(strLinePath, strLineName) = True Then
                        listWrite.Add(strLine)
                    End If
                End If
            End If
       End If
    Next
	If listWrite.Size = 0 Then
	    File.Delete(File.DirApp, "recentitems.lib")
    Else 
	   File.WriteList(File.DirApp, "recentitems.lib", listWrite)
    End If
End Sub

'This is what saves the last file opened or created to the recent items list.
Sub SaveLastFile(strPath As String, strFile As String)
    Dim listWrite As List
    listWrite.Initialize
    listWrite.Add(strPath & "|" & strFile)
    File.WriteList(File.DirApp, "lastfile.lib", listWrite)
End Sub

'From rwblinn, with slight mods
Sub AddRecentItem(menuidx As Int, strPathName As String, strFileName As String)
	Dim mFound As Int
	Dim mTag As String
	Dim fPath As String
	fPath = strPathName.ToLowerCase
	' we need to search for the menu first 
    Dim filesmenu As Menu = MenuBar1.Menus.Get(menuidx)
    mFound = -1
	For Each mi As MenuItem In filesmenu.MenuItems
		mTag = mi.Tag
		mTag = mTag.ToLowerCase 
		If mTag = fPath Then
			mFound = 1
			Exit 
		End If
	Next
	' the menu was not found
	If mFound = -1 Then
		Dim recentfilemenuitem As MenuItem
    	recentfilemenuitem.Initialize(strFileName,"recentfilesmenu")
    	recentfilemenuitem.Tag = strPathName
    	recentfilemenuitem.Text = strFileName
    	filesmenu.MenuItems.Add(recentfilemenuitem)
	End If
End Sub

'From rwblinn, with a lot of mods. It reads in the recent items from the file then adds them to the menu.
Sub AddAllRecentItems
    'Call this from AppInit
    cleanupRecentItems
    Dim recentFilesList As List
    recentFilesList.Initialize
    recentFilesList = ReadRecentItemsList
    Dim subMenuRecentFileNames(recentFilesList.Size + 1) As String
    Dim subMenuRecentFilePath(recentFilesList.Size + 1) As String
    Dim strLine As String
    Dim strLinePath As String
    Dim strLineName As String
    For i = 0 To recentFilesList.Size - 1
       If recentFilesList.Get(i) <> "" Then
            strLine = recentFilesList.Get(i)
            If strLine.IndexOf("|") > 0 Then
                strLinePath = strLine.SubString2(0, strLine.IndexOf("|"))
                strLineName = strLine.SubString(strLine.IndexOf("|") + 1)
                If strLinePath <> "" And strLineName <> "" Then
                    If File.Exists(strLinePath, strLineName) = True Then
                       subMenuRecentFileNames(i) = strLineName
                        subMenuRecentFilePath(i) = File.Combine(strLinePath, strLineName)
                    End If
                End If
           
            End If
       End If
    Next 
    Dim recentFiles As List 
    recentFiles.Initialize
    recentFiles.AddAll(subMenuRecentFileNames)
    'Add a separator first
    RecentItemsAddSeparator(0)
    'Add the list of files
    For i = 0 To recentFiles.Size - 1
        If subMenuRecentFilePath(i) <> "" And subMenuRecentFileNames(i) <> "" Then
           AddRecentItem(0, subMenuRecentFilePath(i), subMenuRecentFileNames(i))
        End If
    Next
End Sub


' get the type of file the code file is
private Sub GetCodeFileType(sPath As String) As String
	If File.Exists("", sPath) = False Then Return "Unknown" 
	Dim fContent As List
	Dim fFirstLine As String
	Dim fType As String
	' read the file contents
	fContent = File.ReadList("", sPath)
	' read the first line of the file
	fFirstLine = fContent.Get(0)
	fType = jMash.MvField(fFirstLine,2,"=")
	Return fType
End Sub


private Sub GetFileLines(sPath As String) As Long
	If File.Exists("", sPath) = False Then Return 0
	Dim fContent As List
	fContent = File.ReadList("", sPath)
	Return fContent.Size
End Sub

private Sub GetSubNames(sPath As String) As List
	Dim subList As List
	Dim fCnt As Int
	Dim fTot As Int
	Dim fStr As String
	Dim fContent As List
	' to store the sub names
	subList.Initialize
	fContent = File.ReadList("", sPath)
	fTot = fContent.Size - 1
	For fCnt = 0 To fTot
		fStr = fContent.Get(fCnt)
		fStr = CleanSubName(fStr)
		If fStr.Length > 0 Then subList.Add(fStr)
	Next	
	Return subList
End Sub

Sub CleanSubName(sSubName As String) As String
	Dim fLine As String
	Dim fStr As String
	Dim bcPos As Int
	fLine = sSubName.ToLowerCase
	fLine = fLine.trim
	If jMash.StartsWith(fLine, "sub ") = True Then 
		fStr = sSubName
		fStr = fStr.Replace("sub ", "")
		fStr = fStr.Replace("Sub ", "")
		bcPos = fStr.IndexOf("(")
		If bcPos <> -1 Then
			fStr = jMash.Left(fStr,bcPos) 
		End If
		Return fStr
	End If
	If jMash.StartsWith(fLine, "private sub ") = True Then 
		fStr = sSubName
		fStr = fStr.Replace("private sub ", "")
		fStr = fStr.Replace("Private Sub ", "")
		fStr = fStr.Replace("private Sub ", "")
		fStr = fStr.Replace("Private sub ", "")
		bcPos = fStr.IndexOf("(")
		If bcPos <> -1 Then
			fStr = jMash.Left(fStr,bcPos) 
		End If
		Return fStr
	End If
	If jMash.StartsWith(fLine, "public sub ") = True Then 
		fStr = sSubName
		fStr = fStr.Replace("public sub ", "")
		fStr = fStr.Replace("Public Sub ", "")
		fStr = fStr.Replace("public Sub ", "")
		fStr = fStr.Replace("Public sub ", "")
		bcPos = fStr.IndexOf("(")
		If bcPos <> -1 Then
			fStr = jMash.Left(fStr,bcPos) 
		End If
		Return fStr
	End If
	Return ""
End Sub

Sub DistributeProject()
	' clear the folder if it exists
	jMash.DeleteFolderRecursive(File.DirApp & "\Profiles\" & prjName)
	' create a directory to hold the contents
	File.MakeDir(File.DirApp, "Profiles\" & prjName)
	File.MakeDir(File.DirApp, "Profiles\" & prjName & "\Libraries")
	File.MakeDir(File.DirApp, "Profiles\" & prjName & "\Files")
	Dim ml As List
	Dim mTot As Int
	Dim mCnt As Int
	Dim mI As Map
	Dim fp As String
	Dim mc As String
	Dim tFile As String
	Dim loc As String
	' process the files for distribution
	ml = DBUtils.ExecuteMaps(jMash.jSQL,"select filePath,maincategory,location from projectfiles order by filePath",Null)
	mTot = ml.Size - 1
	For mCnt = 0 To mTot
		mI = ml.Get(mCnt)
		fp = mI.Get("filepath")
		mc = mI.Get("maincategory")
		loc = mI.Get("location")
		tFile = File.GetName(fp)
		Select Case mc
		Case "Modules"
			tFile = File.DirApp & "\Profiles\" & prjName & "\" & tFile
			File.Copy("",fp,"",tFile) 
		Case "Files"
			tFile = File.DirApp & "\Profiles\" & prjName & "\Files\" & tFile
			File.Copy("",fp,"",tFile) 
		Case "Libraries"
			' only distribute external libraries
			If loc = "External" Then
				tFile = File.DirApp & "\Profiles\" & prjName & "\Libraries\" & tFile
				File.Copy("",fp,"",tFile) 
			End If
		Case Else
			tFile = File.DirApp & "\Profiles\" & prjName & "\" & tFile
			File.Copy("",fp,"",tFile) 
		End Select
	Next
	ac.AsyncZipFolder(File.DirApp & "\Profiles\" & prjName, File.DirApp & "\Distribution" ,prjName & ".zip", "zipfolder")
End Sub

public Sub zipfolder_ZipDone(CompletedWithoutError As Boolean, NbOfFiles As Int)
	Dlg.InformationDialog("Distribute " & NbOfFiles & " Files" , "Distribution file complete","The distribution file has been compressed and is available in Objects folder.")
	jMash.DeleteFolderRecursive(File.DirApp & "\Profiles\" & prjName)
End Sub

Sub treeProject_SelectedItemChanged(SelectedItem As TreeItem)
	If SelectedItem.IsInitialized = False Then Return
	Dim rpt As String
	Dim rptMain As String
	rptMain = SelectedItem.text
	wProfile.LoadHtml("") 
	Select Case rptMain
	Case "Report"
		' show the report
		projectProfile = "select filetype as [File Type], count(*) as [Counted],sum(filesize) as [File Sizes], sum(subs) as [Soub Routines], sum(lines) as Lines from projectfiles group by filetype"
		projectProfile = DBUtils.ExecuteHtml(jMash.jsql,projectProfile,Null,-1)
		wProfile.LoadHtml(projectProfile)
		File.WriteString(File.DirApp, "Reports\" & prjName & "\" & prjName & " Report.html", projectProfile)  
	Case prjName
		rpt = "select filename as [File Name], filetype as [File Type], subs as [Sub Routines], lines as [Code Lines], filesize as [File Size], filemoddate as [Last Modified] from projectfiles where maincategory = '" & rptMain & "' order by filename;"
		rpt = DBUtils.ExecuteHtml(jMash.jsql,rpt,Null,-1)
		wProfile.LoadHtml(rpt) 
		File.WriteString(File.DirApp, "Reports\" & prjName & "\" & prjName & ".html", rpt)  
	Case "Files"
		rpt = "select filename as [File Name], filetype as [File Type], lines as [Code Lines], filesize as [File Size], filemoddate as [Last Modified] from projectfiles where maincategory = '" & rptMain & "' order by filename;"
		rpt = DBUtils.ExecuteHtml(jMash.jsql,rpt,Null,-1)
		wProfile.LoadHtml(rpt) 
		File.WriteString(File.DirApp, "Reports\" & prjName & "\" & prjName & " Files.html", rpt)  
	Case "Libraries"
		rpt = "select filename as [File Name], filetype as [File Type], filesize as [File Size], filemoddate as [Last Modified] from projectfiles where maincategory = '" & rptMain & "' order by filename;"
		rpt = DBUtils.ExecuteHtml(jMash.jsql,rpt,Null,-1)
		wProfile.LoadHtml(rpt) 
		File.WriteString(File.DirApp, "Reports\" & prjName & "\" & prjName & " Libraries.html", rpt)  
	Case "Modules"
		rpt = "select filename as [File Name], filetype as [File Type], subs as [Sub Routines], lines as [Code Lines], filesize as [File Size], filemoddate as [Last Modified] from projectfiles where maincategory = '" & rptMain & "' order by filename;"
		rpt = DBUtils.ExecuteHtml(jMash.jsql,rpt,Null,-1)
		wProfile.LoadHtml(rpt) 
		File.WriteString(File.DirApp, "Reports\" & prjName & "\" & prjName & " Modules.html", rpt)  
	Case Else
		If jMash.EndsWith(rptMain, ".bas") = True Then
			wProfile.LoadHtml("") 
		Else 
			rpt = "select filename as [File Name], filetype as [File Type], subs as [Sub Routines], lines as [Code Lines], filesize as [File Size], filemoddate as [Last Modified] from projectfiles where filetype = '" & rptMain & "' order by filename;"
			rpt = DBUtils.ExecuteHtml(jMash.jsql,rpt,Null,-1)
			wProfile.LoadHtml(rpt)
			File.WriteString(File.DirApp, "Reports\" & prjName & "\" & prjName & " " & rptMain & ".html", rpt)  
		End If 
	End Select
End Sub