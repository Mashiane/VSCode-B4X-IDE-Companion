  "SQL Initialize": {
    "prefix": "sqlinit",
    "body": [
      "Dim ${1:sql} As SQL",
      "${1:sql}.Initialize(${2:File.DirInternal}, \"${3:mydb.db}\", ${4:True})"
    ],
    "description": "Initialize SQL database"
  },
  "SQL Initialize B4J": {
    "prefix": "sqlinitb4j",
    "body": [
      "#AdditionalJar: sqlite-jdbc-3.7.2",
      "",
      "Dim ${1:sql} As SQL",
      "${1:sql}.InitializeSQLite(${2:File.DirData}, \"${3:mydb.db}\", ${4:True})"
    ],
    "description": "Initialize SQL database for B4J"
  },
  "SQL ExecQuery": {
    "prefix": "sqlquery",
    "body": [
      "Dim ${1:rs} As ResultSet = ${2:sql}.ExecQuery(\"${3:SELECT * FROM table}\")",
      "Do While ${1:rs}.NextRow",
      "\t${4:Log(${1:rs}.GetString(\"column_name\"))}",
      "Loop",
      "${1:rs}.Close"
    ],
    "description": "SQL query with ResultSet"
  },
  "SQL ExecQueryAsync": {
    "prefix": "sqlqueryasync",
    "body": [
      "Wait For (${2:sql}.ExecQueryAsync(\"${3:SELECT * FROM table}\", Null)) Complete (${4:Success} As Boolean, ${5:rs} As ResultSet)",
      "If ${4:Success} Then",
      "\tDo While ${5:rs}.NextRow",
      "\t\t$0",
      "\tLoop",
      "\t${5:rs}.Close",
      "End If"
    ],
    "description": "SQL async query with Wait For"
  },
  "SQL ExecNonQuery": {
    "prefix": "sqlnonquery",
    "body": [
      "${1:sql}.ExecNonQuery(\"${2:INSERT INTO table (column) VALUES ('value')}\")"
    ],
    "description": "SQL non-query (INSERT, UPDATE, DELETE)"
  },
  "SQL Transaction": {
    "prefix": "sqltrans",
    "body": [
      "${1:sql}.BeginTransaction",
      "Try",
      "\t${2:sql}.ExecNonQuery(\"${3:SQL statement}\")",
      "\t${1:sql}.TransactionSuccessful",
      "Catch",
      "\tLog(LastException)",
      "End Try",
      "${1:sql}.EndTransaction"
    ],
    "description": "SQL transaction with Try/Catch"
  },
  "SQL Batch Operations": {
    "prefix": "sqlbatch",
    "body": [
      "${1:sql}.BeginTransaction",
      "Try",
      "\tFor Each ${2:item} In ${3:Items}",
      "\t\t${1:sql}.ExecNonQuery2(\"INSERT INTO table VALUES (?)\", Array As Object(${2:item}))",
      "\tNext",
      "\t${1:sql}.TransactionSuccessful",
      "Catch",
      "\tLog(LastException)",
      "End Try",
      "${1:sql}.EndTransaction"
    ],
    "description": "SQL batch operations with transaction"
  },
