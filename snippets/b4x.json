      "\t\tCase ${2:xui.TOUCH_ACTION_DOWN}",
      "\t\t\t${3:' Touch started}",
      "\t\tCase ${4:xui.TOUCH_ACTION_MOVE}",
      "\t\t\t${5:' Touch moved}",
      "\t\tCase ${6:xui.TOUCH_ACTION_UP}",
      "\t\t\t${7:' Touch ended}",
      "\tEnd Select",
      "\tReturn ${8:True}",
      "End Sub"
    ],
