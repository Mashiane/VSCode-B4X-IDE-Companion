  "CustomView DesignerCreateView": {
    "prefix": "customviewdesigner",
    "body": [
      "'This is the base class. In most cases, you should add your views to mBase.",
      "Public Sub DesignerCreateView (Base As Object, Lbl As Label, Props As Map)",
      "\tmBase = Base",
      "\tDim xlbl As B4XView = Lbl",
      "\t$0",
      "End Sub"
    ],
    "description": "CustomView DesignerCreateView method"
  },
  "CustomView Template": {
    "prefix": "customview",
    "body": [
      "#DesignerProperty: Key: ${1:PropertyName}, DisplayName: ${2:Display Name}, FieldType: ${3:String}, DefaultValue: ${4:}",
      "",
      "Sub Class_Globals",
      "\tPrivate mEventName As String",
      "\tPrivate mCallBack As Object",
      "\tPrivate mBase As B4XView",
      "\tPrivate xui As XUI",
      "\tPublic Tag As Object",
      "\tPrivate ${5:customProperty} As ${6:String}",
      "End Sub",
      "",
      "Public Sub Initialize (Callback As Object, EventName As String)",
      "\tmEventName = EventName",
      "\tmCallBack = Callback",
      "End Sub",
      "",
      "Public Sub DesignerCreateView (Base As Object, Lbl As Label, Props As Map)",
      "\tmBase = Base",
      "\tDim xlbl As B4XView = Lbl",
      "\t${7:' Initialize your custom properties from Props}",
      "\t${5:customProperty} = Props.GetDefault(\"${1:PropertyName}\", \"${4:}\")",
      "\t$0",
      "End Sub",
      "",
      "Public Sub GetBase As B4XView",
      "\tReturn mBase",
      "End Sub"
    ],
    "description": "Complete CustomView template with DesignerProperty"
  },
