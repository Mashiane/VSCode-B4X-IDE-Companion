    "configuration": {
      "title": "B4X Companion",
      "properties": {
        "b4xIntellisense.b4aIniPath": {
          "type": "string",
          "default": "",
          "description": "Path to the B4A b4xV5.ini file. Leave empty to auto-detect from %APPDATA%\\Anywhere Software\\Basic4android\\b4xV5.ini."
        },
        "b4xIntellisense.b4iIniPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the B4I b4xV5.ini file for platform-aware folder loading."
        },
        "b4xIntellisense.b4jIniPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the B4J b4xV5.ini file for platform-aware folder loading."
        },
        "b4xIntellisense.b4rIniPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the B4R b4xV5.ini file for platform-aware folder loading."
        },
        "b4xIntellisense.b4aInstallPath": {
          "type": "string",
          "default": "C:\\Program Files\\Anywhere Software\\B4A",
          "description": "Optional installation folder of B4A to locate Themes and other assets."
        },
        "b4xIntellisense.b4iInstallPath": {
          "type": "string",
          "default": "C:\\Program Files (x86)\\Anywhere Software\\B4i",
          "description": "Optional installation folder of B4i to locate Themes and other assets."
        },
        "b4xIntellisense.b4jInstallPath": {
          "type": "string",
          "default": "C:\\Program Files\\Anywhere Software\\B4J",
          "description": "Optional installation folder of B4J to locate Themes and other assets."
        },
        "b4xIntellisense.b4jJavaPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to the java.exe executable to use for running B4J applications. If empty, it will try to detect it from B4J settings or use the system default."
        },
        "b4xIntellisense.b4rInstallPath": {
          "type": "string",
          "default": "C:\\Program Files\\Anywhere Software\\B4R",
          "description": "Optional installation folder of B4R to locate Themes and other assets."
        },
        "b4xIntellisense.b4aWorkspaceFolder": {
          "type": "string",
          "default": "",
          "description": "Default workspace folder for B4A projects. Used when creating new projects from templates."
        },
        "b4xIntellisense.b4iWorkspaceFolder": {
          "type": "string",
          "default": "",
          "description": "Default workspace folder for B4i projects. Used when creating new projects from templates."
        },
        "b4xIntellisense.b4jWorkspaceFolder": {
          "type": "string",
          "default": "",
          "description": "Default workspace folder for B4J projects. Used when creating new projects from templates."
        },
        "b4xIntellisense.b4rWorkspaceFolder": {
          "type": "string",
          "default": "",
          "description": "Default workspace folder for B4R projects. Used when creating new projects from templates."
        },
        "b4xIntellisense.fontFamily": {
          "type": "string",
          "default": "Fira Code Retina",
          "description": "Font family used by extension webviews and previews."
        },
        "b4xIntellisense.fontSize": {
          "type": "number",
          "default": 12,
          "description": "Font size (px) used by extension webviews and previews."
        },
        "b4xIntellisense.wordWrap": {
          "type": "boolean",
          "default": true,
          "description": "When true use word wrap in extension webviews/previews."
        },
        "b4xIntellisense.tabSize": {
          "type": "number",
          "default": 4,
          "description": "Tab size used by extension webviews/previews."
        },
        "b4xIntellisense.autoApplyIni": {
          "type": "string",
          "default": "prompt",
          "enum": [
            "prompt",
            "always",
            "never"
          ],
          "description": "Controls automatic application of Font/Theme hints from platform INI. 'prompt' will ask, 'always' applies silently, 'never' ignores INI hints."
        },
        "b4xIntellisense.autoAddProjectFolderOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "When true the extension will add the project folder as a workspace folder when opening a B4X project. Useful when running Extension Host for testing."
        },
        "b4xIntellisense.autoRestoreWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "When true the extension will automatically attempt to restore the last active B4X project file into the VS Code Explorer if launched inside an empty window."
        },
        "b4xIntellisense.autoOpenProjectFolderOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "When true the extension will open the project folder in the window (replacing the current workspace) when opening a B4X project. Only disable if you want to keep the current workspace when opening a B4X project."
        },
        "b4xIntellisense.autoLoadProjectAssets": {
          "type": "boolean",
          "default": true,
          "description": "When true the extension will automatically load project assets (libraries, modules, start language server) after a B4X project is opened."
        },
        "b4xIntellisense.projectsViewName": {
          "type": "string",
          "default": "Projects",
          "description": "Label used for the Projects view root in the B4X Activity view. Change this to rename the root node shown inside the view."
        },
        "b4xIntellisense.disableConsoleOutput": {
          "type": "boolean",
          "default": true,
          "description": "When true disables all console.log/console.warn/console.error output; use log file for all diagnostics."
        },
        "b4xIntellisense.autoBackupInterval": {
          "type": "number",
          "default": 600000,
          "description": "Auto-backup interval in milliseconds. Default 600000 = 10 minutes."
        },
        "b4xIntellisense.extractMethod.previewBehavior": {
          "type": "string",
          "default": "prompt",
          "enum": [
            "prompt",
            "autoApply",
            "alwaysPreview"
          ],
          "description": "Controls Extract Method preview behavior: 'prompt' shows a preview and asks, 'autoApply' applies edits without prompting, 'alwaysPreview' always opens the preview but does not auto-apply."
        },
        "b4xIntellisense.enableTelemetry": {
          "type": "boolean",
          "default": false,
          "description": "Enable anonymous telemetry for basic feature usage (opt-in)."
        },
        "b4xIntellisense.debug": {
          "type": "boolean",
          "default": false,
          "description": "When true, the extension appends a timestamped log file (b4x-log-YYYYMMDD-HHMMSS.txt) containing debug entries for extension actions."
        },
        "b4xIntellisense.enableUnusedSubDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Detect Unused Subroutines"
        },
        "b4xIntellisense.enableUnusedLibraryDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Detect Unused Libraries"
        },
        "b4xIntellisense.adbPath": {
          "type": "string",
          "default": "",
          "description": "Path to the adb executable. Leave empty to auto-detect from the Android SDK (via platform INI) or prompt on first use."
        },
        "b4xIntellisense.emulatorPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Android emulator executable. Leave empty to use the default Android SDK emulator path."
        },
        "b4xIntellisense.ffmpegPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ffmpeg executable used for GIF capture. Leave empty to auto-detect from common install locations or prompt on first use."
        },
        "b4xIntellisense.googleSheetUrl": {
          "type": "string",
          "default": "https://docs.google.com/spreadsheets/d/1qFvc3Q70RriJS3m_ywBoJvZ47gSTVAuN_X04SI0_XBw/edit?gid=0",
          "description": "Google Sheets URL for fetching library data. Leave empty to disable Google Sheet integration."
        }
      }
    },
