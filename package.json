    "languages": [
      {
        "id": "b4x",
        "aliases": [
          "B4X",
          "B4A",
          "B4J",
          "B4I",
          "B4R"
        ],
        "extensions": [
          ".bas",
          ".b4x",
          ".b4a",
          ".b4i",
          ".b4j",
          ".b4r"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "b4x-bjl-editor",
        "displayName": "B4X Layout Editor",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.bjl"
          },
          {
            "filenamePattern": "*.bil"
          },
          {
            "filenamePattern": "*.bal"
          }
        ]
      }
    ],
    "grammars": [
      {
        "language": "b4x",
        "scopeName": "source.b4x",
        "path": "./syntaxes/b4x.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "b4x",
        "path": "./snippets/b4x.json"
      }
    ],
    "submenus": [
      {
        "id": "b4xIntellisense.submenu",
        "label": "B4X Companion"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "b4xIntellisense.submenu",
          "group": "b4x@1",
          "when": "editorLangId == b4x"
        }
      ],
      "b4xIntellisense.submenu": [
        {
          "command": "b4xIntellisense.gotoDefinition",
          "group": "1_nav@1"
        },
        {
          "command": "b4xIntellisense.peekDefinition",
          "group": "1_nav@2"
        },
        {
          "command": "b4xIntellisense.findReferences",
          "group": "1_nav@3"
        },
        {
          "command": "b4xIntellisense.renameSymbol",
          "group": "1_nav@4"
        },
        {
          "command": "b4xIntellisense.gotoSymbol",
          "group": "1_nav@5"
        },
        {
          "command": "b4xIntellisense.gotoImplementation",
          "group": "1_nav@6"
        },
        {
          "command": "b4xIntellisense.gotoTypeDefinition",
          "group": "1_nav@7"
        },
        {
          "command": "b4xIntellisense.formatDocument",
          "group": "2_fmtDoc@1"
        },
        {
          "command": "b4xIntellisense.unformatDocument",
          "group": "2_fmtDoc@2"
        },
        {
          "command": "b4xIntellisense.formatSelection",
          "group": "3_fmtSel@1"
        },
        {
          "command": "b4xIntellisense.unformatSelection",
          "group": "3_fmtSel@2"
        },
        {
          "command": "b4xIntellisense.blockComment",
          "group": "4_comment@1"
        },
        {
          "command": "b4xIntellisense.unblockComment",
          "group": "4_comment@2"
        },
        {
          "command": "b4xIntellisense.removeBlankLines",
          "group": "5_cleanup@1"
        },
        {
          "command": "b4xIntellisense.removeComments",
          "group": "5_cleanup@2"
        },
        {
          "command": "b4xIntellisense.quickFix",
          "group": "6_tools@1"
        },
        {
          "command": "b4xIntellisense.triggerSuggest",
          "group": "6_tools@2"
        },
        {
          "command": "b4xIntellisense.triggerParameterHints",
          "group": "6_tools@3"
        },
        {
          "command": "b4xIntellisense.searchOnline",
          "group": "7_external@1"
        }
      ],
      "file/menu": [
        {
          "command": "b4xIntellisense.openB4xProject",
          "group": "1_open@10"
        },
        {
          "command": "b4xIntellisense.openPlatform",
          "group": "1_open@15"
        },
        {
          "command": "b4xIntellisense.installProject",
          "when": "b4x.hasBuildableProject",
          "group": "1_open@20"
        },
        {
          "command": "b4xIntellisense.formatDocument",
          "group": "2_edit@10"
        },
        {
          "command": "b4xIntellisense.openDocs",
          "group": "3_help@10"
        },
        {
          "command": "b4xIntellisense.importThemeFromInstall",
          "group": "4_tools@10"
        },
        {
          "command": "b4xIntellisense.runDiagnostics",
          "group": "4_tools@20"
        }
      ],
      "explorer/context": [
        {
          "command": "b4xIntellisense.openB4xProject",
          "when": "resourceExtname =~ /\\.(b4a|b4i|b4j|b4r)/ && explorerResourceIsFolder == false",
          "group": "navigation@20"
        },
        {
          "command": "b4xIntellisense.openPlatform",
          "when": "resourceExtname =~ /\\.(b4a|b4i|b4j|b4r)/ && explorerResourceIsFolder == false",
          "group": "navigation@25"
        },
        {
          "command": "b4xIntellisense.installProject",
          "when": "b4x.hasBuildableProject && resourceExtname =~ /\\.(b4a|b4j)/ && explorerResourceIsFolder == false",
          "group": "navigation@30"
        }
      ],
      "commandPalette": [
