  "scripts": {
    "compile": "node -e \"require('./scripts/bundle.js').restoreDevMain()\" && tsc -p .",
    "bundle": "node ./scripts/bundle.js",
    "prebuild": "node ./scripts/bump-version.js",
    "build": "npm run compile && npm run bundle",
    "watch": "tsc -w -p .",
    "test": "node ./test/runTests.js",
    "test:unit": "node ./test/unit/indexer.test.js",
    "test:integration": "npm run compile && node ./test/runTests.js",
    "test:storage": "tsc -p tsconfig.tests.json && node ./dist/scripts/tests/test-library-index.js",
    "start-lsp": "node server/server.js",
    "inspect-index": "echo 'inspect-index requires server/indexer/inspect-index.js — not yet migrated'",
    "inspect-index:repair": "echo 'inspect-index:repair requires server/indexer/inspect-index.js — not yet migrated'",
    "vscode:prepublish": "npm run build",
    "verify:vsix": "node scripts/verify-vsix.js",
    "package:vsix": "npm run build && npx vsce package && npm run verify:vsix"
  },
