{
  "name": "b4x-intellisense",
  "displayName": "B4X Code IDE Companion",
  "description": "B4X IDE companion for B4A, B4i, B4J, and B4R development in Visual Studio Code. IntelliSense, type inference, go-to-definition, diagnostics, code formatting, library management, and AI integration — all fully offline.",
  "version": "0.1.419",
  "publisher": "AneleMbangaMashy",
  "engines": {
    "vscode": "^1.95.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Requires trust to access B4X project files and run the language server. Basic features work without trust."
    },
    "virtualWorkspaces": false
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "b4x",
    "b4a",
    "intellisense",
    "basic4android",
    "b4i",
    "b4j",
    "b4r",
    "basic4java",
    "basic4ios",
    "basic4arduino"
  ],
  "main": "./dist/extension.js",
  "icon": "images/b4xlogo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mashiane/VSCode-B4X-IDE-Companion"
  },
  "contributes": {
    "commands": [
